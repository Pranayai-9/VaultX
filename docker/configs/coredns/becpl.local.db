$ORIGIN becpl.local.
$TTL 3600
@   IN  SOA ns1.becpl.local. hostmaster.becpl.local. (
            2026111701 ; serial
            7200       ; refresh
            3600       ; retry
            1209600    ; expire
            3600       ; minimum
)
    IN  NS  ns1.becpl.local.

ns1                 IN  A   172.20.10.5
dns                 IN  A   172.20.10.5

